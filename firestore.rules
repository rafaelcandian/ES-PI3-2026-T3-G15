rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bloqueia qualquer acesso por padrão que não tenha regra explícita
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção: usuarios
    // Permite leitura/escrita apenas se o usuário estiver autenticado e o ID do documento for igual ao seu UID
    match /usuarios/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleção: startups
    // Permite leitura para qualquer usuário autenticado; escrita bloqueada pelo mobile
    match /startups/{startupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Coleção: orders
    // Permite leitura para qualquer usuário autenticado
    // Permite criação se o userId da ordem for o UID do próprio criador
    // Permite atualização/deleção se o dono atual da ordem for o usuário autenticado
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Coleção: transactions
    // Permite leitura para qualquer usuário autenticado; escrita bloqueada pelo mobile
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
